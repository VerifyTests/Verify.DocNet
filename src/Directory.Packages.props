    <PackageVersion Include="TUnit" Version="1.69.16" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.181" />
    <PackageVersion Include="Verify" Version="33.1.4" />
    <PackageVersion Include="Verify.DiffPlex" Version="3.3.1" />
    <PackageVersion Include="Verify.TUnit" Version="33.1.4" />
